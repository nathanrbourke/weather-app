<section class="text-white p-5">
  <div class="py-2">
    <h4 class="text-h4"><%= @city_name %>, <%= @state_code %><h4>
    <p class="text-p"><%= @postal_code %></p>
  </div>

  <div class="inline-block flex space-x-8">
    <div>
      <h6 class="text-h6 font-bold text-white">Now</h6>
      <%= render partial: 'forecasts/partials/weather_card', locals: { weather: @current_weather } %>
    </div>
    <div>
      <h6 class="text-h6 font-bold text-white">Upcoming</h6>
      <div class="flex space-x-4">
        <% @daily_forecast.each do |forecast_day| %>
          <%= render partial: 'forecasts/partials/weather_card', locals: { weather: forecast_day } %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="py-2">
</section>
<% state = 'cache' %>
<div class="flex items-center space-x-2">
  <% if state == 'cache' %>
    <div class="w-2 h-2 rounded-full bg-green-500"></div>
    <p class="text-white text-p">From cache</p>
  <% elsif state == 'api' %>
    <div class="w-2 h-2 rounded-full bg-orange-500"></div>
    <p class="text-white text-p">From API</p>
  <% end %>
</div>
<section class="text-white p-5">
<%= render partial: @locale.template_path, locals: { locale: @locale } %>
  <div class="inline-block flex space-x-8">
    <div>
      <div class="flex space-x-4">
        <h4 class="text-h4 font-bold text-white">Now</h4>
        <%= render partial: 'forecasts/partials/cache_pip_indicator', locals: { source_of_data: @current_weather_data_source } %>
      </div>
      <%= render partial: @current_weather.template_path, locals: { weather: @current_weather } %>
    </div>
    <div>
      <div class="flex space-x-4">
        <h4 class="text-h4 font-bold text-white">Upcoming</h4>
        <%= render partial: 'forecasts/partials/cache_pip_indicator', locals: { source_of_data: @daily_forecast_data_source } %>
      </div>
      <div class="flex space-x-4">
        <% @daily_forecast.each do |forecast_day| %>
          <%= render partial: forecast_day.template_path, locals: { weather: forecast_day } %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="py-2">
</section>

<section class="inline-flex m-5 p-4 bg-white">
  <%= form_with(url: forecasts_path, local: true, method: :post) do |form| %>
    <div class="flex space-x-4">
      <div class="flex flex-col space-y-2">
        <div class="min-h-10">
          <%= form.label :address_line_1, "Address Line 1", class: "text-sm text-gray-600" %>
        </div>
        <div class="min-h-10">
          <%= form.label :address_line_2, "Address Line 2 (Optional)", class: "text-sm text-gray-600" %>
        </div>
        <div class="min-h-10">
          <%= form.label :city, "City", class: "text-sm text-gray-600" %>
        </div>
        <div class="min-h-10">
          <%= form.label :state, "State", class: "text-sm text-gray-600" %>
        </div>
        <div class="min-h-10">
          <%= form.label :postal_code, "Postal Code", class: "text-sm text-gray-600" %>
        </div>
      </div>

      <div class="flex flex-col space-y-2">
        <div class="min-h-10">
          <%= form.text_field :address_line_1, required: true, class: "border border-gray-300 p-2" %>
        </div>
        <div class="min-h-10">
          <%= form.text_field :address_line_2, class: "border border-gray-300 p-2" %>
        </div>
        <div class="min-h-10">
          <%= form.text_field :city, required: true, class: "border border-gray-300 p-2" %>
        </div>
        <div class="min-h-10">
          <%= form.text_field :state, required: true, class: "border border-gray-300 p-2" %>
        </div>
        <div class="min-h-10">
          <%= form.text_field :postal_code, required: true, class: "border border-gray-300 p-2" %>
        </div>
      </div>
    </div>

    <div class="min-h-10  pt-2">
      <%= form.submit "Get Weather Report", class: "text-white p-2 rounded bg-green-700" %>
    </div>
  <% end %>
</section>